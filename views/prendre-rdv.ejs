<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Prendre rendez-vous', extraCss: [] }) %>
</head>
<body>
  <%- include('partials/header') %>
  <div class="page">
    <div class="header">
      <div>
        <h1>Prendre rendez-vous</h1>
        <% if (praticien) { %>
          <small>Avec <strong><%= praticien.nom %></strong></small>
        <% } %>
      </div>
      <div></div>
    </div>

    <% if (success) { %>
      <div class="alert success">
         Votre rendez-vous est bien réservé. Vous allez recevoir un email de confirmation .
      </div>
    <% } %>

    <% if (profile) { %>
  <div class="card profile-pro-card">
    <h2 class="profile-pro-title"><%= profile.titre || "Votre praticien" %></h2>

    <div class="profile-pro-top">
      <div class="profile-pro-photo-col">
        <% if (profile.photo_url) { %>
          <img
            src="<%= profile.photo_url %>"
            alt="Photo du praticien"
            class="profile-pro-photo"
          >
        <% } else { %>
          <div class="profile-pro-photo profile-pro-photo-placeholder">
            Aucune photo
          </div>
        <% } %>
      </div>

      <div class="profile-pro-contact">
        <% if (profile.telephone) { %>
          <div class="profile-pro-line">
            <span class="profile-pro-label">Téléphone</span>
            <span class="profile-pro-value"><%= profile.telephone %></span>
          </div>
        <% } %>

        <% if (profile.email_public) { %>
          <div class="profile-pro-line">
            <span class="profile-pro-label">Mail</span>
            <span class="profile-pro-value"><%= profile.email_public %></span>
          </div>
        <% } %>

        <% if (profile.adresse || profile.ville) { %>
          <div class="profile-pro-line">
            <span class="profile-pro-label">Adresse</span>
            <span class="profile-pro-value"><%= [profile.adresse, profile.ville].filter(Boolean).join(", ") %></span>
          </div>
        <% } %>

        <% if (profile.itineraire_url) { %>
          <div class="profile-pro-itineraire">
            <a href="<%= profile.itineraire_url %>" target="_blank" rel="noreferrer">Voir l’itinéraire</a>
          </div>
        <% } %>
      </div>
    </div>

    <div class="profile-pro-infos-row">
      <% if (profile.horaires) { %>
        <div class="profile-pro-box">
          <h3>Horaires</h3>
          <div class="profile-pro-text"><%= profile.horaires %></div>
        </div>
      <% } %>

      <% if (profile.tarifs) { %>
        <div class="profile-pro-box">
          <h3>Tarifs</h3>
          <div class="profile-pro-text"><%= profile.tarifs %></div>
        </div>
      <% } %>

      <% if (profile.paiement) { %>
        <div class="profile-pro-box">
          <h3>Paiements</h3>
          <div class="profile-pro-text"><%= profile.paiement %></div>
        </div>
      <% } %>
    </div>

    <% if (profile.regles) { %>
      <div class="profile-pro-full">
        <h3>Règles / informations</h3>
        <div class="profile-pro-text"><%= profile.regles %></div>
      </div>
    <% } %>

    <% if (profile.description) { %>
      <div class="profile-pro-full">
        <h3>Description</h3>
        <div class="profile-pro-text"><%= profile.description %></div>
      </div>
    <% } %>

    <% if (profile.description_seances) { %>
      <div class="profile-pro-full">
        <h3>Les séances</h3>
        <div class="profile-pro-text"><%= profile.description_seances %></div>
      </div>
    <% } %>
  </div>
<% } %>



    <div class="card">
  <h2>Choisir une séance</h2>

  <% if (typesSeance && typesSeance.length > 0) { %>
    <form method="GET" action="/rdv/<%= praticien.id %>" style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
      <div style="flex:1; min-width:240px;">
        <label>Type de séance</label>
        <select name="type" required>
          <option value="">— Choisir un type —</option>
          <% typesSeance.forEach(t => { %>
            <option
              value="<%= t.id %>"
              data-desc="<%= (t.description || '').replace(/\"/g, '&quot;') %>"
              <%= (selectedTypeId && String(selectedTypeId) === String(t.id)) ? 'selected' : '' %>
            >
              <%= t.nom %>
            </option>
          <% }) %>
          </select>
        <div id="typeDesc" style="margin-top:8px; color:#555;"></div>
      </div>

      <button type="submit" class="btn">Voir les créneaux compatibles</button>

      <% if (selectedTypeId) { %>
        <a class="btn btn-outline" href="/rdv/<%= praticien.id %>">Tout afficher</a>
      <% } %>
    </form>
  <% } else { %>
    <p class="text-muted">Aucun type de séance défini par ce praticien.</p>
  <% } %>

  <hr style="margin:16px 0;">

  <h2>Créneaux disponibles</h2>

  <% if (!selectedTypeId) { %>
    <p class="text-muted">Choisis un type de séance pour afficher les créneaux compatibles.</p>
  <% } else if (creneaux.length === 0) { %>
    <p class="text-muted">Aucun créneau compatible pour ce type pour le moment.</p>
  <% } else { %>
    <ul>
      <% creneaux.forEach(c => { %>
        <li>
          <strong><%= c.date_heure_debut.toLocaleString("fr-FR") %></strong>
          → <%= c.display_fin.toLocaleString("fr-FR") %><br>


          <a href="/rdv/reserver/<%= c.id %>?type=<%= selectedTypeId %>" class="btn">
            Réserver ce créneau
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

  <%- include('partials/footer') %>
  <script>
  (function () {
    const sel = document.querySelector('select[name="type"]');
    const box = document.getElementById("typeDesc");
    if (!sel || !box) return;

    function refresh() {
      const opt = sel.options[sel.selectedIndex];
      box.textContent = (opt && opt.dataset.desc) ? opt.dataset.desc : "";
    }

    sel.addEventListener("change", refresh);
    refresh();
  })();
</script>
</body>
</html>
