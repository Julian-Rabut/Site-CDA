<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Confirmer le rendez-vous', extraCss: [] }) %>
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <%- include('partials/header') %>

  <div class="page-simple">
    <div class="header">
      <div>
        <h1>Confirmer le rendez-vous</h1>
        <small>Vos informations client sont déjà enregistrées.</small>
      </div>
    </div>

    <div class="card">
      <% if (error) { %>
        <div class="message-error"><%= error %></div>
      <% } %>

      <p>
        Créneau choisi :
        <br>
        <strong><%= creneau.date_heure_debut.toLocaleString("fr-FR") %></strong>
        →
        <strong><%= displayFin.toLocaleString("fr-FR") %></strong>
      </p>

      <div style="margin:14px 0; padding:12px; border:1px solid #e5e5e5; border-radius:10px;">
        <strong>Compte client utilisé</strong><br>
        <%= clientSession.nom %><br>
        <%= clientSession.email %><br>
        <%= clientSession.telephone || '—' %>
      </div>

      <form action="/rdv/reserver" method="POST">
        <input type="hidden" name="creneau_id" value="<%= creneau.id %>">

        <% if (selectedTypeId) { %>
          <input type="hidden" name="type_seance_id" value="<%= selectedTypeId %>">
        <% } else { %>
          <label>Type de séance</label>
          <select name="type_seance_id" required>
            <option value="">— Choisir un type —</option>
            <% typesSeance.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.nom %></option>
            <% }) %>
          </select>
        <% } %>

        <label>Commentaire (optionnel)</label>
        <textarea name="commentaire" rows="3" placeholder="Informations utiles..."></textarea>

        <button class="btn" type="submit">Confirmer le rendez-vous</button>
      </form>

      <p class="text-muted" style="margin-top:12px;">
        Besoin de modifier vos coordonnées ?
        <a href="/client/compte?tab=fiche">Mettre à jour ma fiche client</a>
      </p>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>