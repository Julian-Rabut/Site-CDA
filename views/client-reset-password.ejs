<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Réinitialiser le mot de passe', extraCss: [] }) %>
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <div class="page-simple">
    <div class="header">
      <div>
        <h1>Nouveau mot de passe</h1>
        <small>Choisissez votre nouveau mot de passe.</small>
      </div>
    </div>

    <div class="card">
      <% if (error) { %>
        <div class="message-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert success">
          <%= success %><br>
          <a href="/client/login">Aller à la connexion</a>
        </div>
      <% } %>

      <% if (token) { %>
        <form action="/client/reset-password/<%= token %>" method="POST">
          <label>Nouveau mot de passe</label>
          <input type="password" name="mot_de_passe" required>

          <label>Confirmation du nouveau mot de passe</label>
          <input type="password" name="mot_de_passe_confirm" required>

          <button type="submit" class="btn">Enregistrer le nouveau mot de passe</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>