<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Choisir un praticien', extraCss: [] }) %>
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <%- include('partials/header') %>

  <div class="page">
    <div class="header">
      <div>
        <h1>Prendre un Rendez-vous</h1>
      </div>
    </div>

    <div class="card">
      <h2>Dans Ma Bulle</h2>

      <% if (praticiens.length === 0) { %>
        <p class="text-muted">Aucun praticien enregistré pour le moment.</p>
      <% } else { %>
        <ul>
          <% praticiens.forEach(p => { %>
            <li>
              <div style="display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;">
                <div>
                  <strong><%= p.nom %></strong><br>
                  <span class="text-muted"><%= p.email %></span>
                </div>
                <a href="/rdv/<%= p.id %>" class="btn">Voir les créneaux</a>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>