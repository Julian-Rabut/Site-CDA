<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Mot de passe oublié', extraCss: [] }) %>
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <div class="page-simple">
    <div class="header">
      <div>
        <h1>Mot de passe oublié</h1>
        <small>Recevez un lien pour choisir un nouveau mot de passe.</small>
      </div>
    </div>

    <div class="card">
      <% if (error) { %>
        <div class="message-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (typeof devLink !== "undefined" && devLink) { %>
        <div class="message-success">
          Mode local : <a href="<%= devLink %>">ouvrir le lien de réinitialisation</a>
        </div>
      <% } %>

      <form action="/client/mot-de-passe-oublie" method="POST">
        <label>Email</label>
        <input type="email" name="email" required>

        <button type="submit" class="btn">Envoyer le lien</button>
      </form>

      <p class="text-muted" style="margin-top:12px;">
        <a href="/client/login">Retour à la connexion</a>
      </p>
    </div>
  </div>
</body>
</html>